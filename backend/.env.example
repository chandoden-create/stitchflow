# ==============================================================================
# StitchFlow Backend Environment Configuration
# ==============================================================================

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://stitchflow:stitchflow_dev@localhost:5432/stitchflow?schema=public"

# JWT Authentication
JWT_SECRET="stitchflow-super-secret-jwt-key-replace-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# Redis (for rate limiting and job queues)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# S3 / MinIO Object Storage (for garment photos)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="stitchflow-photos"
S3_FORCE_PATH_STYLE="true"

# Meta WhatsApp Business Platform Cloud API
# Note: Keep WHATSAPP_SANDBOX_MODE="true" for local dev without Meta credentials
WHATSAPP_SANDBOX_MODE="true"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_VERIFY_TOKEN="stitchflow-webhook-verify"
WHATSAPP_API_VERSION="v19.0"

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=60
