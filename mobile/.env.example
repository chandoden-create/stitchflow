# ==============================================================================
# StitchFlow Mobile Environment Configuration (Expo)
# ==============================================================================

# Backend API Base URL
# For local physical device testing with Expo Go, use your computer's local LAN IP:
# e.g., EXPO_PUBLIC_API_URL="http://192.168.1.5:3000"
# For iOS Simulator: "http://localhost:3000"
# For Android Emulator: "http://10.0.2.2:3000"
EXPO_PUBLIC_API_URL="http://localhost:3000"

# App Branding
EXPO_PUBLIC_APP_NAME="StitchFlow"
EXPO_PUBLIC_CURRENCY_SYMBOL="₹"
